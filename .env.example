# Scraper Configuration
TIMEOUT=10
MAX_RETRIES=3
DELAY_BETWEEN_REQUESTS=1.5
HEADLESS=true

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# GCP Configuration (optional)
GCP_PROJECT=
BIGQUERY_DATASET=

# Web App
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_RELOAD=true

# Google Gemini API (optional) — for intelligent role variant generation
# Free tier: 60 requests/minute, unlimited queries per day
# Get your key at: https://ai.google.dev/
GOOGLE_API_KEY=
